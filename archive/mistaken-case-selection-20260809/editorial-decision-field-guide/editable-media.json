    "minimum_content_span": 0.95,
    "bottom_whitespace": {
      "content_layer_ids": ["eyebrow", "title", "dek", "context-note", "failure-table", "tactics", "stop-rules", "reframing", "action-strip", "production-watermark"],
      "maximum_ratio": 0.02
    },
    "thumbnail": {
