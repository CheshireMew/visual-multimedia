  "data_fields": [
    {"id": "eyebrow", "name": "主题眉题", "kind": "string", "default": "当努力和结果之间的关系突然变得不稳定"},
    {"id": "title", "name": "主标题", "kind": "string", "default": "用 AI 用抑郁了，咋办？"},
    {"id": "dek", "name": "导语", "kind": "string", "default": "最折磨人的不是一次失败，而是：你认真调整了，结果却像随机数。久了，大脑会得出“我做什么都没用”。先别急着继续补指令——先判断这次失败属于哪一层。"},
    {"id": "context_note", "name": "语境说明", "kind": "string", "default": "这里说的是被反复失败磨出来的无力感，不是在替抑郁症做诊断。"},
    {"id": "failure_heading", "name": "失败分层标题", "kind": "string", "default": "先分层：这次到底是哪种失败？"},
    {
      "id": "failure_layers",
      "name": "失败分层",
      "kind": "table",
      "default": [
        {"number": "1", "label": "能查明的工程问题", "clue": "文件没读到、路径或格式错了、数据没传进去、工具没有触发。", "action": "继续查。这里的修正和结果之间，通常有稳定因果。"},
        {"number": "2", "label": "能用测试改善的问题", "clue": "提示词、示例、上下文顺序、规则长短，让结果时好时坏。", "action": "别凭手感调。固定 20 个案例：14/20 → 17/20；剩下 3 次是概率尾部，不等于方法全坏。"},
        {"number": "3", "label": "当前模型做不到", "clue": "规则一多就顾此失彼；审美、长流程、指令服从长期不稳。", "action": "允许写下工程结论：当前模型做不好。换模型、降要求，或把高判断环节交给人。"},
        {"number": "4", "label": "平台自己变了", "clue": "昨天能用，今天变差；模型版本、上下文处理或工具路由悄悄变化。", "action": "禁止无限调试看不见的依赖。保留测试和版本条件，等待或更换平台。"}
      ],
      "columns": [
        {"id": "number", "name": "序号", "kind": "string"},
        {"id": "label", "name": "层级", "kind": "string"},
        {"id": "clue", "name": "看到什么", "kind": "string"},
        {"id": "action", "name": "怎么做", "kind": "string"}
      ]
    },
    {"id": "tactics_heading", "name": "换打法标题", "kind": "string", "default": "别再给黑盒加规矩，给系统加结构"},
    {
      "id": "tactics",
      "name": "换打法",
      "kind": "table",
      "default": [
        {"label": "拆开任务", "body": "把“一次写好”改成：初稿 → 挑问题 → 重写。大流程也一样，拆到每一步都有可见结果。"},
        {"label": "增加选择", "body": "一次生成 5 个 → 让 AI 排序 → 保留前 2 个 → 再细化。单次不稳，就给系统搜索空间。"},
        {"label": "留一刀给人", "body": "AI 扩大选项，人只做“哪个真的好”的高价值选择。8 小时变 40 分钟，就已经有用，不必迷信全自动。"}
      ],
      "columns": [
        {"id": "label", "name": "方法", "kind": "string"},
        {"id": "body", "name": "说明", "kind": "string"}
      ]
    },
    {"id": "stop_heading", "name": "停止规则标题", "kind": "string", "default": "先写停止规则，别把自己交给老虎机"},
    {
      "id": "stop_rules",
      "name": "停止规则",
      "kind": "list",
      "default": [
        "同一问题最多 3 次有依据的修改。说清：怀疑原因 X → 改动 Y → 观察指标 Z。",
        "拆阶段、固定测试、加候选和审稿后，仍无可测提升：暂停。",
        "人工返工已经吃掉省下的时间：暂停。",
        "可能等模型升级自然解决：保留测试、数据和流程，冻结当前版本。"
      ]
    },
    {"id": "reframe_heading", "name": "成功标准标题", "kind": "string", "default": "重写成功标准：不追求“永远听话”，追求“稳定有价值”"},
    {
      "id": "reframes",
      "name": "成功标准",
      "kind": "table",
      "default": [
        {"label": "先测正贡献", "body": "拿 30～50 条真实材料，固定模型和上下文，盲测：裸模型 / 当前方案 / 极简方案。谁真的赢，让数据说话。"},
        {"label": "发布不等于完美", "body": "裸模型 40 分、用了方案平均 65 分，已经能提供价值。写清测试条件和不稳定场景，就可以发布。"},
        {"label": "输出不等于你", "body": "你的能力在于提问题、定标准、设计实验、做选择。模型只是中间的随机执行；它今天变笨，不等于你也变笨。"}
      ],
      "columns": [
        {"id": "label", "name": "标准", "kind": "string"},
        {"id": "body", "name": "说明", "kind": "string"}
      ]
    },
    {"id": "action_label", "name": "行动标签", "kind": "string", "default": "现在就做"},
    {"id": "action_steps", "name": "行动步骤", "kind": "string", "default": "选 20 个真实案例 → 跑基线 → 一次只改一个假设 → 3 轮没提升就换结构 → 仍无正贡献就冻结"},
    {"id": "closing", "name": "收束句", "kind": "string", "default": "你要夺回的，不是对模型的完全控制，而是对继续、换打法或停止的决定权。"},
    {"id": "production_watermark", "name": "制作水印", "kind": "string", "default": "𝕏@0xCheshire"}
  ],
  "quality": {
    "canvas_selector": "#mediaCanvas",
