{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-multimedia.anime-avatar-project.v2",
  "title": "Visual Multimedia Anime Avatar Project v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "version",
    "library",
    "render"
  ],
  "properties": {
    "protocol": {
      "const": "visual-multimedia-anime-avatar-project"
    },
    "version": {
      "const": 2
    },
    "library": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "package_file"
          ],
          "properties": {
            "kind": {
              "const": "project"
            },
            "package_file": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "version"
          ],
          "properties": {
            "kind": {
              "const": "registered"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          }
        }
      ]
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "internal_fps",
        "delivery_fps",
        "output_size",
        "required_library_reuse_grade"
      ],
      "properties": {
        "language": {
          "const": "zh-CN"
        },
        "internal_fps": {
          "type": "integer",
          "minimum": 20,
          "maximum": 60
        },
        "delivery_fps": {
          "type": "integer",
          "minimum": 24,
          "maximum": 60
        },
        "output_size": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 256
            },
            {
              "type": "integer",
              "minimum": 256
            }
          ],
          "items": false
        },
        "required_library_reuse_grade": {
          "enum": [
            "limited",
            "general"
          ],
          "description": "limited 是完整可用的基础合同；只有项目明确需要同一元音的中等与完整两档真实峰值时才选择 general。"
        }
      }
    }
  }
}
