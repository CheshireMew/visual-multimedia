{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-multimedia.media-project-state.v1",
  "title": "Visual Multimedia Media Project State v1 (archived)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "version",
    "project_id",
    "status",
    "current_checkpoint",
    "contracts",
    "creative_approvals",
    "artifacts",
    "blockers",
    "next_action",
    "updated_at"
  ],
  "properties": {
    "protocol": {
      "const": "visual-multimedia-media-project-state"
    },
    "version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "status": {
      "enum": ["in-progress", "waiting-approval", "blocked", "complete"]
    },
    "current_checkpoint": {
      "enum": [
        "brief",
        "script",
        "style",
        "composition",
        "motion-sound",
        "assembly",
        "review",
        "delivery"
      ]
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_sources",
        "resource_adoptions",
        "transcript",
        "clip_selections",
        "timeline",
        "style_profile",
        "sound_profile",
        "promotion_candidates",
        "review",
        "delivery"
      ],
      "properties": {
        "media_sources": {
          "type": "string",
          "minLength": 1
        },
        "resource_adoptions": {
          "type": ["string", "null"]
        },
        "transcript": {
          "type": ["string", "null"]
        },
        "clip_selections": {
          "type": ["string", "null"]
        },
        "timeline": {
          "type": ["string", "null"]
        },
        "style_profile": {
          "type": ["string", "null"]
        },
        "sound_profile": {
          "type": ["string", "null"]
        },
        "promotion_candidates": {
          "type": ["string", "null"]
        },
        "review": {
          "type": ["string", "null"]
        },
        "delivery": {
          "type": ["string", "null"]
        }
      }
    },
    "creative_approvals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approval"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_action": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "status",
        "artifact",
        "artifact_sha256",
        "recorded_at",
        "notes"
      ],
      "properties": {
        "scope": {
          "enum": ["script", "style", "composition", "motion-sound"]
        },
        "status": {
          "enum": ["pending", "approved", "rejected"]
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "recorded_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "file", "sha256"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "kind": {
          "enum": [
            "script",
            "style-sample",
            "composition-sample",
            "motion-sound-sample",
            "timeline",
            "preview",
            "final"
          ]
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
