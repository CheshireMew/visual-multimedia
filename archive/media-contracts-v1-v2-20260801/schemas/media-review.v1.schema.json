{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-multimedia.media-review.v1",
  "title": "Visual Multimedia Media Review v1 (archived)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "version",
    "project_state",
    "reviewed_media",
    "status",
    "full_review",
    "findings"
  ],
  "properties": {
    "protocol": {
      "const": "visual-multimedia-media-review"
    },
    "version": {
      "const": 1
    },
    "project_state": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "reviewed_media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "duration_seconds", "frame_rate"],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "frame_rate": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        }
      }
    },
    "status": {
      "enum": ["pending", "changes-requested", "passed", "failed"]
    },
    "full_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "reviewed_at", "notes"],
      "properties": {
        "completed": {
          "type": "boolean"
        },
        "reviewed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "category",
        "start_seconds",
        "end_seconds",
        "start_frame",
        "end_frame",
        "timeline_element_ids",
        "evidence",
        "requested_change",
        "resolution"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "severity": {
          "enum": ["blocker", "major", "minor", "polish"]
        },
        "category": {
          "enum": [
            "content",
            "captions",
            "layout",
            "layering",
            "continuity",
            "motion",
            "audio",
            "sync",
            "rights",
            "technical"
          ]
        },
        "start_seconds": {
          "type": "number",
          "minimum": 0
        },
        "end_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "start_frame": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "end_frame": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "timeline_element_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "requested_change": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/requestedChange"
            }
          ]
        },
        "resolution": {
          "$ref": "#/$defs/resolution"
        }
      }
    },
    "requestedChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before",
        "after",
        "duration_seconds",
        "easing",
        "layer_order",
        "invariants",
        "unaffected_ranges"
      ],
      "properties": {
        "before": {
          "type": "string"
        },
        "after": {
          "type": "string",
          "minLength": 1
        },
        "duration_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "easing": {
          "type": "string"
        },
        "layer_order": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unaffected_ranges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/range"
          }
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_seconds", "end_seconds"],
      "properties": {
        "start_seconds": {
          "type": "number",
          "minimum": 0
        },
        "end_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "notes", "verified_media_sha256"],
      "properties": {
        "status": {
          "enum": ["open", "fixed", "accepted"]
        },
        "notes": {
          "type": "string"
        },
        "verified_media_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
