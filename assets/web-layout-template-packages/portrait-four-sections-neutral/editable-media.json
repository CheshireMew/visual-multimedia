  "theme_variables": [
    {"id": "background", "name": "背景", "kind": "color", "css_variable": "--background", "default": "#FFFFFF"},
    {"id": "surface", "name": "内容底面", "kind": "color", "css_variable": "--surface", "default": "#F2F3F5"},
    {"id": "text", "name": "正文", "kind": "color", "css_variable": "--text", "default": "#171A1F"},
    {"id": "muted", "name": "次级文字", "kind": "color", "css_variable": "--muted", "default": "#667085"},
    {"id": "rule", "name": "分隔线", "kind": "color", "css_variable": "--rule", "default": "#D0D5DD"},
    {"id": "accent", "name": "占位强调色", "kind": "color", "css_variable": "--accent", "default": "#315EFB"},
    {"id": "font_display", "name": "标题字体", "kind": "font", "css_variable": "--font-display", "default": "\"Noto Sans SC\", \"Microsoft YaHei\", sans-serif"},
    {"id": "font_body", "name": "正文字体", "kind": "font", "css_variable": "--font-body", "default": "\"Noto Sans SC\", \"Microsoft YaHei\", sans-serif"},
    {"id": "font_display_weight", "name": "标题字重", "kind": "number", "css_variable": "--font-display-weight", "default": 760, "constraints": {"minimum": 500, "maximum": 900, "step": 20}},
    {"id": "font_body_weight", "name": "正文字重", "kind": "number", "css_variable": "--font-body-weight", "default": 520, "constraints": {"minimum": 400, "maximum": 700, "step": 20}}
