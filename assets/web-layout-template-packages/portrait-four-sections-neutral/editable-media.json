      "layout_id": "portrait-four-sections",
      "duration_ms": 1000,
      "primary_blocks": 4,
      "steps": [
        {
          "id": "complete",
          "at_ms": 0,
          "label": "完整内容",
          "state_kind": "start",
          "review": false,
          "description": "固定竖版画布同时展示标题、导语、四个一级分区和页脚。"
        }
      ],
      "motion": {
        "complexity": "static",
        "driver": "none",
        "semantic_purpose": "静态卡片按单一阅读顺序承载四个一级分区。",
        "key_state_review": "none",
        "camera": null
      },
      "parameters": {},
      "data": {},
      "asset_slots": {}
    }
