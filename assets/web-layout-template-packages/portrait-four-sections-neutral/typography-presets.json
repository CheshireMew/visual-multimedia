        "local_names": ["方正舒体", "FZShuTi"],
        "weight": 400
      },
      "body": {
        "family": "\"Noto Sans SC\", \"Microsoft YaHei\", sans-serif",
        "local_names": ["Noto Sans SC"],
        "weight": 550
      }
    },
