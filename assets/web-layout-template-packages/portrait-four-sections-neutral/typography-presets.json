      "use_when": ["强标题", "观点卡", "现代封面", "高对比信息"],
      "avoid_when": ["柔和阅读", "古典书写感", "大段正文"],
      "source": {
        "kind": "system-local",
        "license_note": "按 SIL Open Font License 1.1 使用；分发时随项目保留许可证。",
        "source_url": "https://fonts.google.com/noto/specimen/Noto+Sans+SC"
