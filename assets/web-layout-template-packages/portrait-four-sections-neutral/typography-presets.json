{
  "protocol": "visual-multimedia-typography-presets",
  "version": 2,
  "profiles": [
    {
      "id": "modern-cn",
      "name": "现代中文",
      "description": "适合社交卡、技术说明、清单和界面信息",
      "use_when": ["社交卡", "技术说明", "清单", "界面信息"],
      "avoid_when": ["需要书写感", "需要传统隶意"],
      "source": {
        "kind": "system-local",
        "license_note": "Noto 字体按 SIL Open Font License 1.1 使用；分发时随项目保留许可证。",
        "source_url": "https://fonts.google.com/noto/specimen/Noto+Sans+SC"
      },
      "display": {
        "family": "\"Noto Sans SC\", \"Microsoft YaHei\", sans-serif",
        "local_names": ["Noto Sans SC"],
        "weight": 800
      },
      "body": {
        "family": "\"Noto Sans SC\", \"Microsoft YaHei\", sans-serif",
        "local_names": ["Noto Sans SC"],
        "weight": 550
      }
    },
    {
      "id": "editorial-cn",
      "name": "编辑阅读",
      "description": "适合评论、引用、文化与出版感内容",
      "use_when": ["评论", "引用", "文化", "出版"],
      "avoid_when": ["高密度界面", "儿童内容"],
      "source": {
        "kind": "system-local",
        "license_note": "仅在当前机器已安装标题与正文字体时启用；对外分发前核对实际字体许可证。"
      },
      "display": {
        "family": "\"Noto Serif SC\", \"Source Han Serif SC\", SimSun, serif",
        "local_names": ["Noto Serif SC", "Source Han Serif SC"],
        "weight": 700
      },
      "body": {
        "family": "\"Noto Sans SC\", \"Microsoft YaHei\", sans-serif",
        "local_names": ["Noto Sans SC"],
        "weight": 550
      }
    },
    {
      "id": "windows-cn",
      "name": "Windows 通用中文",
      "description": "适合缺少 Noto 字体时的本机制作",
      "use_when": ["Windows 本机制作", "通用无衬线"],
      "avoid_when": ["需要跨机器携带字体", "需要鲜明展示气质"],
      "source": {
        "kind": "system-local",
        "license_note": "Windows 系统字体只作为本机来源，不复制进可分发网页包。"
      },
      "display": {
        "family": "\"Microsoft YaHei\", sans-serif",
        "local_names": ["Microsoft YaHei"],
        "weight": 700
      },
      "body": {
        "family": "\"Microsoft YaHei\", sans-serif",
        "local_names": ["Microsoft YaHei"],
        "weight": 550
      }
    },
    {
