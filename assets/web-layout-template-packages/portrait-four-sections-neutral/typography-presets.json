      },
      "body": {
        "family": "\"Noto Sans SC\", \"Microsoft YaHei\", sans-serif",
        "local_names": ["Noto Sans SC"],
        "weight": 550
      }
    },
    {
      "id": "fz-xiangli-display",
      "name": "方正祥隶",
      "description": "带隶意与装饰性的完整标题字体；只有本机存在完整字库时启用",
      "use_when": ["传统标题", "民俗", "短句海报", "参考图需要隶意"],
      "avoid_when": ["长正文", "高密度数据", "缺少完整字体文件"],
      "unavailable_label": "未安装完整字体",
      "source": {
        "kind": "system-local",
        "license_note": "只检测完整本机字体，不把少数字形子集冒充完整字库；商用、发布或嵌入前按方正字库授权范围核对。",
        "source_url": "https://www.foundertype.com/index.php/FontInfo/index/id/163.html"
      },
      "display": {
        "family": "\"方正祥隶简体\", \"方正祥隶\", \"FZXiangLiJW--GB1-0\", serif",
        "local_names": ["方正祥隶简体", "方正祥隶", "FZXiangLiJW--GB1-0", "FZXIANGLJW--GB1-0"],
        "weight": 400
      },
      "body": {
        "family": "\"Noto Sans SC\", \"Microsoft YaHei\", sans-serif",
        "local_names": ["Noto Sans SC"],
        "weight": 550
      }
    },
    {
      "id": "zihun-4181-warm-child-shadow",
      "name": "字魂4181温暖童稚影体",
      "description": "童趣、圆润、带投影感的标题字体；只有精确字体存在时启用",
      "use_when": ["儿童", "亲子", "轻松标题", "童趣卡片"],
      "avoid_when": ["严肃报告", "长正文", "缺少精确字体文件"],
      "unavailable_label": "未安装精确字体",
      "source": {
        "kind": "system-local",
        "license_note": "登记用户指定的精确名称，不用相似字体或名称近似字体替代；采用前核对字魂授权与实际字体文件。",
        "source_url": "https://izihun.com/"
      },
      "display": {
        "family": "\"字魂4181温暖童稚影体\", \"字魂4181号-温暖童稚影体\", cursive",
        "local_names": ["字魂4181温暖童稚影体", "字魂4181号-温暖童稚影体"],
        "weight": 400
      },
      "body": {
        "family": "\"Noto Sans SC\", \"Microsoft YaHei\", sans-serif",
        "local_names": ["Noto Sans SC"],
        "weight": 550
      }
