  "parameters": [
    {
      "descriptor": {
        "id": "motion_intensity",
        "label": "运动强度",
        "description": "控制语义对象的位移和缩放幅度，不改变状态顺序。",
        "group": "运动",
        "kind": "number",
        "control": "slider",
        "default": 0.72,
        "unit": "ratio",
        "constraints": {
          "minimum": 0,
          "maximum": 1.5,
          "step": 0.01
        },
        "options_source": null,
        "timeline": "keyframe"
      },
      "binding": {
        "scope": "global",
        "css_variable": "--motion-intensity"
      }
    },
    {
      "descriptor": {
        "id": "connector_speed",
        "label": "关系线速度",
        "description": "控制流程、时间线和因果关系的绘制推进速度。",
        "group": "运动",
        "kind": "number",
        "control": "slider",
        "default": 1,
        "unit": "ratio",
        "constraints": {
          "minimum": 0.5,
          "maximum": 2,
          "step": 0.05
