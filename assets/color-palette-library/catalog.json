{
  "protocol": "visual-multimedia-color-palettes",
  "version": 1,
  "selection_policy": {
    "priority": [
      "user",
      "brand",
      "reference",
      "confirmed-project-profile",
      "built-in-palette"
    ],
    "rules": [
      "一件作品只采用一张内置配色卡，不跨卡拼色",
      "默认使用卡中原始色值和颜色职责；需要不同气质时改选另一张卡",
      "配色卡不提供构图、字体、容器、圆角、阴影或题材模板",
      "题材标签只能帮助排除明显不合适的候选，不能单独决定配色",
      "纯色只表示无纹理、无渐变、无照片，不自动等于暖白",
      "极简文字提取没有其它视觉来源时采用 neutral-ink-red，并使用纯白底"
    ]
  },
  "sample": {
    "eyebrow": "VISUAL MULTIMEDIA · PALETTE",
    "title": "颜色只负责关系",
    "body": "同一套内容，用不同色彩职责建立气质与层级。",
    "label": "关键结论"
  },
  "palettes": [
    {
      "id": "neutral-ink-red",
      "name": "中性黑白红",
      "character": "清楚、直接、中性",
      "use_when": ["极简文字画面", "观点", "清单", "信息提取"],
      "avoid_when": ["明确纸张感", "儿童内容", "深色演播室"],
      "roles": {
        "background": "#FFFFFF",
        "surface": "#F2F4F7",
        "text": "#171A1F",
        "muted": "#667085",
        "accent": "#C93436",
        "accent_text": "#FFFFFF"
      }
    },
    {
      "id": "warm-paper-cinnabar",
      "name": "暖纸朱砂",
      "character": "人文、克制、纸张感",
      "use_when": ["文化评论", "编辑出版", "手稿", "引用"],
      "avoid_when": ["中性信息提取", "强科技感", "高密度数据"],
      "roles": {
        "background": "#F4EFE6",
        "surface": "#E7DDCE",
        "text": "#27231F",
        "muted": "#6F665C",
        "accent": "#B34331",
        "accent_text": "#FFF9F2"
      }
    },
    {
