      "use_when": ["明确采用瑞士信息网格", "共享列主导的中性公共信息", "黑白灰与钴蓝的高秩序方向"],
      "avoid_when": ["仅因技术工具或比较题材", "情绪照片", "手作叙事", "儿童内容"],
      "roles": {
        "background": "#F8F8F4",
