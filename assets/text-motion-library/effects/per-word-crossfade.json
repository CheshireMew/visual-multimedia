{
  "protocol": "visual-multimedia-text-motion",
  "version": 1,
  "id": "per-word-crossfade",
  "name": "逐词交叉替换",
  "aliases": ["词组交叉淡化", "word crossfade"],
  "status": "active",
  "source_ids": ["sakura-animate-text"],
  "host": {"sizing": "content", "overflow": "visible", "requires_final_width": false, "style_ownership": "project"},
  "intent": {
    "operations": ["enter", "exit", "replace"],
    "default_operation": "replace",
    "purpose": "在编辑型标题或短句更新时保留词组边界和从容节奏。",
    "energy": "calm",
    "semantic_tags": ["word", "crossfade", "editorial", "replace"]
  },
  "segmentation": {
    "unit": "word",
    "order": "forward",
    "whitespace": "preserve",
    "layout_measurement": "none"
  },
  "timing": {
    "enter": {"duration_ms": 700, "stagger_ms": 70, "easing": "ease-out"},
    "exit": {"duration_ms": 500, "stagger_ms": 40, "easing": "ease-in"},
    "replace": {"mode": "crossfade", "overlap_ms": 170, "micro_delay_ms": 70},
    "hold_ms": 900
  },
  "renderer": {
    "kind": "keyframes",
    "transform_origin": "center",
    "unit_variation": "none",
    "tracks": {
      "enter": [
        {"offset": 0, "values": {"opacity": 0, "y_px": 8}},
        {"offset": 1, "values": {"opacity": 1, "y_px": 0}}
      ],
      "exit": [
        {"offset": 0, "values": {"opacity": 1, "y_px": 0}},
        {"offset": 1, "values": {"opacity": 0, "y_px": -6}}
      ]
    }
  },
  "constraints": {
    "recommended_max_graphemes": 54,
    "recommended_max_lines": 3,
    "layout_sensitive": false,
    "motion_intensity": "low",
    "reduced_motion": {"strategy": "fade", "duration_ms": 180},
    "notes": ["适合有清楚词边界的短句。", "中英文混排必须检查真实分词。"]
  },
  "review": {
    "key_states": [
      {"operation": "replace", "id": "old-visible", "at": 0, "meaning": "旧短句按词完整可读。"},
      {"operation": "replace", "id": "word-overlap", "at": 0.55, "meaning": "词组交叉期间不出现长时间重影。"},
      {"operation": "replace", "id": "new-visible", "at": 1, "meaning": "新短句按原始空白稳定显示。"}
    ]
  }
}
