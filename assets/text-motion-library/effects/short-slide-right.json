  "source_ids": ["sakura-animate-text"],
  "host": {"sizing": "layout-slot", "overflow": "hidden", "requires_final_width": true, "style_ownership": "project"},
  "intent": {
    "operations": ["enter", "exit", "replace"],
    "default_operation": "enter",
    "purpose": "用短距离共享方向和逐词透明度节奏建立横向标题。",
    "energy": "moderate",
    "semantic_tags": ["word", "slide-right", "compact", "headline"]
  },
  "segmentation": {
    "unit": "word",
    "order": "forward",
    "whitespace": "preserve",
    "layout_measurement": "none"
  },
  "timing": {
    "enter": {"duration_ms": 520, "stagger_ms": 92, "easing": "ease-out"},
    "exit": {"duration_ms": 320, "stagger_ms": 0, "easing": "ease-in-out"},
    "replace": {"mode": "sequential", "overlap_ms": 0, "micro_delay_ms": 70},
    "hold_ms": 850
  },
  "renderer": {
    "kind": "keyframes",
    "transform_origin": "left",
    "unit_variation": "none",
    "tracks": {
      "enter": [
        {"offset": 0, "values": {"opacity": 0, "x_px": -24, "blur_px": 1.2}},
        {"offset": 1, "values": {"opacity": 1, "x_px": 0, "blur_px": 0}}
      ],
      "exit": [
        {"offset": 0, "values": {"opacity": 1, "x_px": 0, "blur_px": 0}},
        {"offset": 1, "values": {"opacity": 0, "x_px": 12, "blur_px": 1}}
      ]
    }
  },
  "constraints": {
    "recommended_max_graphemes": 42,
    "recommended_max_lines": 2,
    "layout_sensitive": true,
    "motion_intensity": "medium",
    "reduced_motion": {"strategy": "fade", "duration_ms": 150},
    "notes": ["位移保持短小，不把标题甩出安全区。", "横向方向应服务阅读或空间关系。"]
  },
  "review": {
    "key_states": [
      {"operation": "enter", "id": "left-offset", "at": 0, "meaning": "词组处于短距左偏移并保持原布局。"},
      {"operation": "enter", "id": "word-reveal", "at": 0.55, "meaning": "词组共享右移方向并逐词显现。"},
      {"operation": "enter", "id": "aligned", "at": 1, "meaning": "所有词回到最终横向位置。"}
    ]
  }
