  "review": {
    "key_states": [
      {"operation": "exit", "id": "full-size", "at": 0, "meaning": "文字以正常尺寸完整显示。"},
      {"operation": "exit", "id": "closed", "at": 1, "meaning": "文字向中心收束并完全淡出。"}
