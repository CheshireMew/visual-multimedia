  "quality": {
    "canvas_selector": "#mediaCanvas",
    "roundtrip": {
      "data_field": "title_primary",
      "layer_id": "title-primary"
    },
    "required_layer_ids": [
      "title-primary",
      "mcp-panel",
      "cli-panel",
      "api-panel",
      "core-rail",
      "creator-avatar",
      "creator-name",
      "creator-role"
    ],
    "bounds_tolerance_px": 2,
    "minimum_font_px": {
      "title-primary": 52,
      "creator-name": 16,
      "creator-role": 10
    },
    "minimum_gaps": [
      {
        "above": "title-primary",
        "below": "mcp-panel",
        "min_px": 20
      },
      {
        "above": "mcp-panel",
        "below": "core-rail",
        "min_px": 20
      }
    ],
    "content_bounds_layer_ids": [
      "title-primary",
      "mcp-panel",
      "cli-panel",
      "api-panel",
      "core-rail",
      "creator-avatar",
      "creator-name",
      "creator-role"
    ],
    "minimum_content_span": 0.92,
    "thumbnail": {
      "width": 1280,
      "minimum_text_px": 8,
      "text_layer_ids": [
        "title-primary",
        "mcp-panel",
        "cli-panel",
        "api-panel",
        "core-rail"
      ]
    }
  },
  "delivery": {
    "preview": "local-server",
    "remote_dependencies": "forbid"
  },
  "resources": [
    "editable-media-runtime.js",
    "style-profile.json"
  ],
  "frame_readiness": {
    "default_timeout_ms": 10000,
    "maximum_timeout_ms": 30000,
    "retry_limit": 1
  }
