    {
      "id": "interface-flow",
      "name": "三种接口工作方式",
      "page_role": "explanation",
      "content_shape": "three-diagram-landscape",
      "layout_id": "three-interface-flow",
      "duration_ms": 1000,
      "primary_blocks": 4,
      "steps": [
        {
          "id": "page",
          "at_ms": 0,
          "label": "完整画面",
          "state_kind": "start",
          "review": false,
          "description": "横向展示 MCP、CLI、API 各自的调用者、接口过程和结果。"
        }
      ],
      "motion": {
        "complexity": "static",
        "driver": "none",
        "semantic_purpose": "用三张流程图解释三种接口如何工作。",
        "key_state_review": "none",
        "camera": null
      },
      "parameters": {},
      "data": {},
      "asset_slots": {
        "creator-avatar": {
          "data_field": "creator_avatar"
        }
      }
    }
  ],
  "layout_contracts": [
    {
      "id": "three-interface-flow",
      "name": "Three visual interface flows",
      "page_roles": [
        "explanation"
      ],
      "content_shapes": [
        "three-diagram-landscape"
      ],
      "required_data_fields": [
        "title_primary",
        "mcp_name",
        "mcp_expansion",
        "mcp_caption",
        "cli_name",
        "cli_expansion",
        "cli_caption",
        "api_name",
        "api_expansion",
        "api_caption",
        "creator_avatar",
        "creator_name",
        "creator_role"
      ],
      "required_layer_ids": [
        "title-primary",
        "mcp-panel",
        "cli-panel",
        "api-panel",
        "core-rail",
        "creator-avatar",
        "creator-name",
        "creator-role"
      ],
      "title_layer_ids": [
        "title-primary"
      ],
      "content_layer_ids": [
        "mcp-panel",
        "cli-panel",
        "api-panel",
        "core-rail"
      ],
      "capacity": {
        "maximum_primary_blocks": 4
      },
      "asset_slots": [
        {
          "id": "creator-avatar",
          "required": true,
          "ratio": "1:1",
          "fit": "contain",
          "preserve_full_frame": true
        }
      ]
