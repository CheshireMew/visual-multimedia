    },
    {
      "id": "headline",
      "name": "主标题",
      "kind": "string",
      "default": "人机协同回路"
    },
    {
      "id": "agent_title",
      "name": "Agent 节点",
      "kind": "string",
      "default": "Agent"
    },
    {
      "id": "client_title",
      "name": "客户端节点",
      "kind": "string",
      "default": "MCP 客户端"
    },
    {
      "id": "server_title",
      "name": "服务端节点",
      "kind": "string",
      "default": "MCP 服务端"
    },
    {
      "id": "tools_title",
      "name": "工具节点",
      "kind": "string",
      "default": "已有工具"
    },
    {
      "id": "state_title",
      "name": "共享状态",
      "kind": "string",
      "default": "共享业务状态"
    },
    {
      "id": "human_ui_title",
      "name": "人的界面",
      "kind": "string",
      "default": "人的界面"
    },
    {
      "id": "boundary",
      "name": "能力边界",
      "kind": "string",
      "default": "MCP 负责把工具能力标准化给 Agent；界面同步、权限和冲突处理仍由应用负责。"
    },
    {
      "id": "creator_avatar",
      "name": "作者头像",
      "kind": "media-source",
      "default": "cheshire-avatar"
    },
    {
      "id": "creator_name",
      "name": "作者署名",
      "kind": "string",
      "default": "柴郡@0xCheshire"
    },
    {
      "id": "creator_role",
      "name": "作者说明",
      "kind": "string",
      "default": "原创图解"
    }
  ],
  "quality": {
    "canvas_selector": "#mediaCanvas",
    "roundtrip": {
      "data_field": "headline",
      "layer_id": "headline"
    },
    "required_layer_ids": [
      "identity",
      "headline",
      "creator",
      "diagram"
    ],
    "bounds_tolerance_px": 2,
    "minimum_font_px": {
      "headline": 28
    },
    "minimum_gaps": [
      {
        "above": "headline",
        "below": "diagram",
        "min_px": 20
      }
    ],
    "content_bounds_layer_ids": [
      "identity",
      "headline",
      "creator",
      "diagram"
    ],
    "minimum_content_span": 0.9,
    "thumbnail": {
      "width": 480,
      "minimum_text_px": 8,
      "text_layer_ids": [
        "headline"
      ]
    }
  },
  "delivery": {
    "preview": "local-server",
    "remote_dependencies": "forbid"
  },
  "resources": [
    "editable-media-runtime.js",
    "style-profile.json",
    "assets/fonts/Xiaolai-Regular.ttf",
    "assets/fonts/Xiaolai-OFL.txt"
  ],
  "frame_readiness": {
    "default_timeout_ms": 10000,
    "maximum_timeout_ms": 30000,
    "retry_limit": 1
  }
}
