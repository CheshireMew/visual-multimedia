    "required_layer_ids": [
      "kicker",
      "title",
      "summary",
      "curator-avatar",
      "curator-name",
      "list-panel"
    ],
    "bounds_tolerance_px": 1,
    "minimum_font_px": {
      "kicker": 12,
      "title": 44,
      "summary": 18,
      "curator-name": 12
    },
    "minimum_gaps": [
      {
        "above": "title",
        "below": "summary",
        "min_px": 24
      }
    ],
    "content_bounds_layer_ids": [
      "kicker",
      "title",
      "summary",
      "list-panel"
    ],
    "minimum_content_span": 0.9,
    "thumbnail": {
      "width": 360,
      "minimum_text_px": 8,
      "text_layer_ids": [
        "title"
      ]
    }
  },
  "delivery": {
    "preview": "local-server",
    "remote_dependencies": "forbid"
  },
  "resources": [
