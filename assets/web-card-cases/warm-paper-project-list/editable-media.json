    {
      "id": "items",
      "name": "GitHub projects",
      "kind": "table",
      "default": [
        {
          "name": "qu-ai-wei",
          "stars": "299 star",
          "description": "中文去 AI 味 Skill，会一起处理套话、抽象表达、句子节奏和语体，改稿时也不会凭空补充事实。",
          "url": "https://github.com/LifelongLazyLearner/qu-ai-wei"
        },
        {
          "name": "说人话",
          "stars": "818 star",
          "description": "写 README、开发进度和技术文章很合适，版本号、命令和责任归属都能保住，改完更自然，也不耽误正事。",
          "url": "https://github.com/MrGeDiao/shuorenhua"
        },
        {
          "name": "De-AI Prompt Enhancer",
          "stars": "566 star",
          "description": "它把 7 篇真实文章做成了风格参考，可以换成自己的旧文章，让 AI 熟悉你的写法，再清掉残留的机器痕迹。",
          "url": "https://github.com/OUBIGFA/De-AI-Prompt-Enhancer-Writer-Booster-SKILL"
        },
        {
          "name": "Humanizer",
          "stars": "3.1 万 star",
          "description": "英文去 AI 味的基础款，专门清理固定开场、空洞强调和模板式收尾，规则简单，接进各种 Agent 都方便。",
          "url": "https://github.com/blader/humanizer"
        },
        {
          "name": "Stop-Slop",
          "stars": "1.4 万 star",
          "description": "适合已经成稿的英文内容，专门收拾无用铺垫、商业黑话、结构套话和故作深沉的碎句。",
          "url": "https://github.com/hardikpandya/stop-slop"
        },
        {
          "name": "no-ai-slop",
          "stars": "2696 star",
          "description": "原稿已经有个人语气时很适合用它，既能只检测，也能按最小幅度修改，尽量不把作者自己的声音一起抹掉。",
          "url": "https://github.com/petergyang/no-ai-slop"
        },
        {
          "name": "Writing Agent",
          "stars": "335 star",
          "description": "想从选题、搜集证据一路做到审稿和导出，可以直接使用这套完整写作流程，去 AI 味只是其中一环。",
          "url": "https://github.com/dongbeixiaohuo/writing-agent"
        }
      ],
