{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-multimedia.media-stage-template.v1",
  "title": "Visual Multimedia Media Stage Template v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "version",
    "id",
    "template_version",
    "name",
    "media_kinds",
    "stages"
  ],
  "properties": {
    "protocol": {"const": "visual-multimedia-media-stage-template"},
    "version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "template_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "name": {"type": "string", "minLength": 1},
    "media_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["video", "mixed-video", "audio", "podcast"]}
    },
    "stages": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/stage"}
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "label",
        "purpose",
        "depends_on",
        "required_artifact_roles"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "order": {"type": "integer", "minimum": 1},
        "label": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
        },
        "required_artifact_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
        }
      }
    }
  }
}
