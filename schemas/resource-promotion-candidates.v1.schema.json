{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-multimedia.resource-promotion-candidates.v1",
  "title": "Visual Multimedia Resource Promotion Candidates v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "version",
    "project_id",
    "candidates"
  ],
  "properties": {
    "protocol": {
      "const": "visual-multimedia-resource-promotion-candidates"
    },
    "version": {
      "const": 1
    },
    "project_id": {
      "$ref": "#/$defs/identifier"
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "target_kind",
        "scope",
        "source",
        "source_id",
        "source_sha256",
        "target_library_id",
        "target_item_id",
        "rationale",
        "evidence",
        "created_at",
        "decision"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "enum": [
            "candidate",
            "accepted",
            "rejected"
          ]
        },
        "target_kind": {
          "enum": [
            "creator-media",
            "production-assets",
            "web-components",
            "visual-style-profile",
            "sound-production-profile"
          ]
        },
        "scope": {
          "enum": [
            "project",
            "series"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "target_library_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_item_id": {
          "$ref": "#/$defs/identifier"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "decision": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "decided_at",
            "notes",
            "published_target"
          ],
          "properties": {
            "decided_at": {
              "type": "string",
              "format": "date-time"
            },
            "notes": {
              "type": "string",
              "minLength": 1
            },
            "published_target": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    }
  }
}
