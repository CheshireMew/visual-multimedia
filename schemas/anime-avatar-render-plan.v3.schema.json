{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-multimedia.anime-avatar-render-plan.v3",
  "title": "Immutable Segmented Anime Avatar Render Plan v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "version", "status", "plan_id", "created_at", "inputs",
    "library_capabilities", "execution", "master", "units", "seams",
    "summary", "approval"
  ],
  "properties": {
    "protocol": {"const": "visual-multimedia-anime-avatar-render-plan"},
    "version": {"const": 3},
    "status": {"enum": ["ready", "rejected"]},
    "plan_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "inputs": {"$ref": "#/$defs/records"},
    "library_capabilities": {"type": "object"},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_seconds", "audio_duration_seconds", "internal_fps",
        "delivery_fps", "master_size"
      ],
      "properties": {
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "audio_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "internal_fps": {"type": "integer", "minimum": 20},
        "delivery_fps": {"type": "integer", "minimum": 20},
        "master_size": {
          "type": "array",
          "prefixItems": [{"type": "integer"}, {"type": "integer"}],
          "items": false
        }
      }
    },
    "master": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cache_key", "content_sha256", "manifest_sha256", "width", "height", "fps"
      ],
      "properties": {
        "cache_key": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "order", "start_frame", "end_frame_exclusive", "frame_count",
          "local_input_sha256", "schedule", "diagnostics", "internal_seams",
          "render_instructions_sha256", "render_schedule_sha256", "cache_key"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "order": {"type": "integer", "minimum": 1},
          "start_frame": {"type": "integer", "minimum": 0},
          "end_frame_exclusive": {"type": "integer", "minimum": 1},
          "frame_count": {"type": "integer", "minimum": 1},
          "local_input_sha256": {"$ref": "#/$defs/sha256"},
          "render_instructions_sha256": {"$ref": "#/$defs/sha256"},
          "render_schedule_sha256": {"$ref": "#/$defs/sha256"},
          "schedule": {"$ref": "#/$defs/artifact"},
          "diagnostics": {"$ref": "#/$defs/artifact"},
          "internal_seams": {
            "type": "object",
            "additionalProperties": false,
            "required": ["count", "rejected"],
            "properties": {
              "count": {"type": "integer", "minimum": 0},
              "rejected": {"type": "integer", "minimum": 0}
            }
          },
          "cache_key": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "seams": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "left_unit_id", "right_unit_id", "boundary_frame",
          "artifact", "cache_key", "status"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "left_unit_id": {"type": "string", "minLength": 1},
          "right_unit_id": {"type": "string", "minLength": 1},
          "boundary_frame": {"type": "integer", "minimum": 1},
          "artifact": {"$ref": "#/$defs/artifact"},
          "cache_key": {"$ref": "#/$defs/sha256"},
          "status": {"enum": ["ready", "rejected"]}
        }
      }
    },
    "summary": {"type": "object"},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "confirmed_at", "approved_plan_sha256"],
      "properties": {
        "status": {"enum": ["pending", "confirmed"]},
        "confirmed_at": {"type": ["string", "null"]},
        "approved_plan_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "sha256"],
      "properties": {
        "locator": {"type": "string", "pattern": "^(project|skill)://"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "records": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/artifact"}
    }
  }
}
