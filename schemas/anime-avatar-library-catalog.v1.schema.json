{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-multimedia.anime-avatar-library-catalog.v1",
  "title": "Visual Multimedia Anime Avatar Library Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "version",
    "default_library",
    "libraries"
  ],
  "properties": {
    "protocol": {
      "const": "visual-multimedia-anime-avatar-library-catalog"
    },
    "version": {
      "const": 1
    },
    "default_library": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/libraryIdentity"
        }
      ]
    },
    "libraries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "display_name",
          "versions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "versions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "status",
                "reuse_grade",
                "package_file"
              ],
              "properties": {
                "version": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                },
                "status": {
                  "const": "registered"
                },
                "reuse_grade": {
                  "enum": [
                    "limited",
                    "general"
                  ]
                },
                "package_file": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "libraryIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    }
  }
}
