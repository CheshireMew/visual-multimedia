{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-multimedia.anime-avatar-source-catalog.v1",
  "title": "Visual Multimedia Anime Avatar Source Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "version",
    "default_source",
    "sources"
  ],
  "properties": {
    "protocol": {
      "const": "visual-multimedia-anime-avatar-source-catalog"
    },
    "version": {
      "const": 1
    },
    "default_source": {
      "type": "null"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "display_name",
          "versions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "versions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "status",
                "package_file"
              ],
              "properties": {
                "version": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                },
                "status": {
                  "const": "registered"
                },
                "package_file": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
