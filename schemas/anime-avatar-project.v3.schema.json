{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-multimedia.anime-avatar-project.v3",
  "title": "Anime Avatar Project v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "version", "library", "render"],
  "properties": {
    "protocol": {"const": "visual-multimedia-anime-avatar-project"},
    "version": {"const": 3},
    "library": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "package_file"],
          "properties": {
            "kind": {"const": "project"},
            "package_file": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "version"],
          "properties": {
            "kind": {"const": "registered"},
            "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
            "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
          }
        }
      ]
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "internal_fps", "delivery_fps", "output_size"],
      "properties": {
        "language": {"const": "zh-CN"},
        "internal_fps": {"type": "integer", "minimum": 20, "maximum": 60},
        "delivery_fps": {"type": "integer", "minimum": 24, "maximum": 60},
        "output_size": {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 256},
            {"type": "integer", "minimum": 256}
          ],
          "items": false
        }
      }
    }
  }
}
