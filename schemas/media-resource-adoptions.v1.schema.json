{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-multimedia.media-resource-adoptions.v1",
  "title": "Visual Multimedia Media Resource Adoptions v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "version",
    "project_id",
    "adoptions"
  ],
  "properties": {
    "protocol": {
      "const": "visual-multimedia-media-resource-adoptions"
    },
    "version": {
      "const": 1
    },
    "project_id": {
      "$ref": "#/$defs/identifier"
    },
    "adoptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/adoption"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "adoption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "library_id",
        "library_version",
        "library_kind",
        "item_id",
        "registry_package_sha256",
        "consumer",
        "media_source_id",
        "package",
        "content_sha256",
        "adopted_at"
      ],
      "properties": {
        "library_id": {
          "$ref": "#/$defs/identifier"
        },
        "library_version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "library_kind": {
          "enum": [
            "creator-media",
            "production-assets",
            "web-components"
          ]
        },
        "item_id": {
          "$ref": "#/$defs/identifier"
        },
        "registry_package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "consumer": {
          "enum": [
            "media-sources",
            "editable-media"
          ]
        },
        "media_source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "package": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "adopted_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
