{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-multimedia.media-build-report.v2",
  "title": "Visual Multimedia Media Build Report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "version",
    "profile",
    "build_plan",
    "build_plan_sha256",
    "producer",
    "units",
    "audio",
    "captions",
    "assembly",
    "output",
    "completed_at"
  ],
  "properties": {
    "protocol": {"const": "visual-multimedia-media-build-report"},
    "version": {"const": 2},
    "profile": {"type": "string", "minLength": 1},
    "build_plan": {"$ref": "#/$defs/localPath"},
    "build_plan_sha256": {"$ref": "#/$defs/sha256"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "sha256", "tools"],
      "properties": {
        "entry": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "tools": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "file",
          "sha256",
          "bytes",
          "frames",
          "status",
          "cache_key"
        ],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "file": {"$ref": "#/$defs/localPath"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "bytes": {"type": "integer", "minimum": 1},
          "frames": {"type": "integer", "minimum": 1},
          "status": {"enum": ["rendered", "reused"]},
          "cache_key": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "status", "file", "sha256", "cache_key"],
      "properties": {
        "strategy": {"enum": ["continuous-master", "unit-audio", "none"]},
        "status": {"enum": ["rendered", "reused", "absent", "included-in-units"]},
        "file": {"oneOf": [{"$ref": "#/$defs/localPath"}, {"type": "null"}]},
        "sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "cache_key": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "file",
        "sha256",
        "render_file",
        "render_sha256",
        "visible_in_standalone_output"
      ],
      "properties": {
        "mode": {"enum": ["burned-in", "embedded-track", "sidecar", "none"]},
        "file": {"oneOf": [{"$ref": "#/$defs/localPath"}, {"type": "null"}]},
        "sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "render_file": {"oneOf": [{"$ref": "#/$defs/localPath"}, {"type": "null"}]},
        "render_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "visible_in_standalone_output": {"type": "boolean"}
      }
    },
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "cache_key"],
      "properties": {
        "status": {"enum": ["assembled", "reused"]},
        "cache_key": {"$ref": "#/$defs/sha256"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256",
        "bytes",
        "frames",
        "duration_seconds",
        "width",
        "height",
        "fps",
        "audio_sample_rate",
        "audio_channels"
      ],
      "properties": {
        "file": {"$ref": "#/$defs/localPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "frames": {"type": "integer", "minimum": 1},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "audio_sample_rate": {"type": "integer", "minimum": 1},
        "audio_channels": {"type": "integer", "minimum": 1}
      }
    },
    "completed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "localPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
