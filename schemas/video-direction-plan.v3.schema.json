{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-multimedia.video-direction-plan.v3",
  "title": "Visual Multimedia Video Direction Plan v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "version", "project", "content_brief", "narration", "pronunciations", "presenter", "generation_jobs", "authoring_groups", "scenes"],
  "properties": {
    "protocol": {"const": "visual-multimedia-video-direction"},
    "version": {"const": 3},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_project_id", "source", "media_script_version", "authoring_input_sha256", "created_at"],
      "properties": {
        "media_project_id": {"$ref": "#/$defs/id"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_id", "source_version", "content_unit_id", "snapshot"],
          "properties": {
            "source_id": {"$ref": "#/$defs/id"},
            "source_version": {"type": "string", "minLength": 1},
            "content_unit_id": {"$ref": "#/$defs/id"},
            "snapshot": {"$ref": "#/$defs/fileIntegrity"}
          }
        },
        "media_script_version": {"type": "string", "minLength": 1},
        "authoring_input_sha256": {"$ref": "#/$defs/sha256"},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "content_brief": {"$ref": "#/$defs/contentBrief"},
    "narration": {"$ref": "#/$defs/narration"},
    "pronunciations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["written", "spoken", "note"],
        "properties": {
          "written": {"type": "string", "minLength": 1},
          "spoken": {"type": "string", "minLength": 1},
          "note": {"type": "string"}
        }
      }
    },
    "presenter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "source_id", "approval"],
      "properties": {
        "mode": {"enum": ["human", "none"]},
        "source_id": {"type": ["string", "null"], "minLength": 1},
        "approval": {"$ref": "#/$defs/approval"}
      }
    },
    "generation_jobs": {"const": "generation-jobs.json"},
    "authoring_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "segment_ids", "continuity_reason"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "segment_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "continuity_reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment_id", "source_refs", "purpose", "voiceover_ref", "required_readable_result", "creative_proposal", "visual_plan", "timing", "generation_job_ids"],
        "properties": {
          "segment_id": {"$ref": "#/$defs/id"},
          "source_refs": {"$ref": "#/$defs/sourceRefs"},
          "purpose": {"type": "string", "minLength": 1},
          "voiceover_ref": {"type": "string", "pattern": "^narration#.+$"},
          "required_readable_result": {"type": "string", "minLength": 1},
          "creative_proposal": {"$ref": "#/$defs/creativeProposal"},
          "visual_plan": {"$ref": "#/$defs/visualPlan"},
          "timing": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "estimated_seconds"],
            "properties": {
              "source": {"enum": ["text-estimate", "real-speech", "existing-media", "fixed-spec"]},
              "estimated_seconds": {"type": "number", "exclusiveMinimum": 0}
            }
          },
          "generation_job_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableString": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "fileIntegrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "bytes"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "sourceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "confirmed_at", "evidence"],
      "properties": {
        "status": {"const": "approved"},
        "confirmed_at": {"type": "string", "format": "date-time"},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "contentBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "promise", "core_claim", "supporting_points", "required_facts", "risk_flags"],
      "properties": {
        "audience": {"type": "string", "minLength": 1},
        "promise": {"type": "string", "minLength": 1},
        "core_claim": {"type": "string", "minLength": 1},
        "supporting_points": {
          "type": "array", "minItems": 1,
          "items": {"type": "object", "additionalProperties": false, "required": ["id", "text", "source_refs"], "properties": {"id": {"$ref": "#/$defs/id"}, "text": {"type": "string", "minLength": 1}, "source_refs": {"$ref": "#/$defs/sourceRefs"}}}
        },
        "required_facts": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": false, "required": ["text", "source_refs"], "properties": {"text": {"type": "string", "minLength": 1}, "source_refs": {"$ref": "#/$defs/sourceRefs"}}}
        },
        "risk_flags": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": false, "required": ["risk", "handling", "source_refs"], "properties": {"risk": {"type": "string", "minLength": 1}, "handling": {"type": "string", "minLength": 1}, "source_refs": {"$ref": "#/$defs/sourceRefs"}}}
        }
      }
    },
    "narration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "text", "sha256", "source_refs", "major_editorial_changes"],
      "properties": {
        "status": {"const": "confirmed"},
        "text": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "source_refs": {"$ref": "#/$defs/sourceRefs"},
        "major_editorial_changes": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": false, "required": ["id", "summary", "source_refs", "approval"], "properties": {"id": {"$ref": "#/$defs/id"}, "summary": {"type": "string", "minLength": 1}, "source_refs": {"$ref": "#/$defs/sourceRefs"}, "approval": {"$ref": "#/$defs/approval"}}}
        }
      }
    },
    "creativeProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual_idea", "composition", "material_route", "material_integration", "motion_sequence", "key_states", "seam_in", "seam_out", "revision_reason"],
      "properties": {
        "visual_idea": {"type": "string", "minLength": 1},
        "composition": {"type": "string", "minLength": 1},
        "material_route": {"enum": ["native", "provided", "search", "generate", "mixed"]},
        "material_integration": {"type": "string", "minLength": 1},
        "motion_sequence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["preparation", "primary_action", "dependent_overlap", "settle_and_hold", "focus"],
          "properties": {
            "preparation": {"type": "string", "minLength": 1},
            "primary_action": {"type": "string", "minLength": 1},
            "dependent_overlap": {"type": "string", "minLength": 1},
            "settle_and_hold": {"type": "string", "minLength": 1},
            "focus": {"type": "string", "minLength": 1}
          }
        },
        "key_states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "role", "description"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "role": {"enum": ["start", "change", "result", "hold"]},
              "description": {"type": "string", "minLength": 1}
            }
          }
        },
        "seam_in": {"type": "string", "minLength": 1},
        "seam_out": {"type": "string", "minLength": 1},
        "revision_reason": {"$ref": "#/$defs/nullableString"}
      }
    },
    "reviewRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewed_at", "summary", "package_sha256"],
      "properties": {
        "status": {"enum": ["accepted", "revised"]},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "summary": {"type": "string", "minLength": 1},
        "package_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "review": {"anyOf": [{"$ref": "#/$defs/reviewRecord"}, {"type": "null"}]},
    "realization": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "recipe_id", "style_id", "variant_id", "selection", "review"],
          "properties": {
            "kind": {"const": "recipe"},
            "recipe_id": {"$ref": "#/$defs/id"},
            "style_id": {"$ref": "#/$defs/id"},
            "variant_id": {"$ref": "#/$defs/id"},
            "selection": {"$ref": "#/$defs/fileIntegrity"},
            "review": {"$ref": "#/$defs/review"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "package", "package_sha256", "implementation_sha256", "manifest_sha256", "scene_id", "variant_id", "adopted_at", "review"],
          "properties": {
            "kind": {"const": "project-package"},
            "package": {"type": "string", "minLength": 1},
            "package_sha256": {"$ref": "#/$defs/sha256"},
            "implementation_sha256": {"$ref": "#/$defs/sha256"},
            "manifest_sha256": {"$ref": "#/$defs/sha256"},
            "scene_id": {"$ref": "#/$defs/id"},
            "variant_id": {"$ref": "#/$defs/id"},
            "adopted_at": {"type": "string", "format": "date-time"},
            "review": {"$ref": "#/$defs/reviewRecord"}
          }
        },
        {"type": "null"}
      ]
    },
    "visualPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "source_ids", "relationship_kind", "placement_mode", "aspect_ratio", "selection_reason", "realization"],
      "properties": {
        "source_kind": {"enum": ["human", "screen-recording", "evidence", "explanatory-broll", "packaging"]},
        "source_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "relationship_kind": {"anyOf": [{"enum": ["process", "phase-timeline", "layered-framework", "causal-loop", "input-output-toolchain", "comparison-matrix", "decompose-assemble", "metric-dashboard", "evidence-before-after", "layout"]}, {"type": "null"}]},
        "placement_mode": {"enum": ["full-frame", "presenter-split", "transparent-overlay"]},
        "aspect_ratio": {"enum": ["16:9", "9:16", "1:1"]},
        "selection_reason": {"type": "string", "minLength": 1},
        "realization": {"$ref": "#/$defs/realization"}
      },
      "allOf": [
        {"if": {"properties": {"source_kind": {"enum": ["explanatory-broll", "packaging"]}}}, "then": {"properties": {"realization": {"type": "object"}}}},
        {"if": {"properties": {"source_kind": {"const": "explanatory-broll"}}}, "then": {"properties": {"relationship_kind": {"type": "string"}}}},
        {"if": {"properties": {"source_kind": {"enum": ["human", "screen-recording"]}}}, "then": {"properties": {"source_ids": {"minItems": 1}, "realization": {"type": "null"}}}},
        {"if": {"properties": {"source_kind": {"const": "evidence"}}}, "then": {"properties": {"realization": {"type": "null"}}}}
      ]
    }
  }
}
