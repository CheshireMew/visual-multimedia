{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-multimedia.anime-avatar-track-clips.v1",
  "title": "Anime Avatar Track Clips v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "version", "fps", "width", "height", "duration_frames",
    "clips", "audio"
  ],
  "properties": {
    "protocol": {"const": "visual-multimedia-anime-avatar-track-clips"},
    "version": {"const": 1},
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "duration_frames": {"type": "integer", "minimum": 1},
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "kind", "timeline_start_frame", "duration_frames", "file", "sha256"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["unit-core", "seam-bridge"]},
          "timeline_start_frame": {"type": "integer", "minimum": 0},
          "duration_frames": {"type": "integer", "minimum": 1},
          "file": {"$ref": "#/$defs/localPath"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeline_start_frame", "duration_frames", "file", "sha256"],
      "properties": {
        "timeline_start_frame": {"const": 0},
        "duration_frames": {"type": "integer", "minimum": 1},
        "file": {"$ref": "#/$defs/localPath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "localPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
