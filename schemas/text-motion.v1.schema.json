{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-multimedia.text-motion.v1",
  "title": "Visual Multimedia Text Motion v1 Documents",
  "oneOf": [
    {
      "$ref": "#/$defs/library"
    },
    {
      "$ref": "#/$defs/effect"
    },
    {
      "$ref": "#/$defs/catalog"
    },
    {
      "$ref": "#/$defs/selection"
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativeJsonPath": {
      "type": "string",
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+\\.json$"
    },
    "relativeJsPath": {
      "type": "string",
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+\\.js$"
    },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "license",
        "copyright",
        "source_reference",
        "adaptation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "license": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "copyright": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_reference": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "adaptation": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "library": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "version",
        "library_version",
        "name",
        "default_locale",
        "sources"
      ],
      "properties": {
        "protocol": {
          "const": "visual-multimedia-text-motion-library"
        },
        "version": {
          "const": 1
        },
        "library_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "default_locale": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRecord"
          }
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations",
        "default_operation",
        "purpose",
        "energy",
        "semantic_tags"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "enter",
              "exit",
              "replace",
              "emphasis"
            ]
          }
        },
        "default_operation": {
          "enum": [
            "enter",
            "exit",
            "replace",
            "emphasis"
          ]
        },
        "purpose": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "energy": {
          "enum": [
            "calm",
            "moderate",
            "expressive"
          ]
        },
        "semantic_tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "segmentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "order",
        "whitespace",
        "layout_measurement"
      ],
      "properties": {
        "unit": {
          "enum": [
            "whole",
            "grapheme",
            "word",
            "line"
          ]
        },
        "order": {
          "enum": [
            "forward",
            "reverse",
            "center-out",
            "edges-in"
          ]
        },
        "whitespace": {
          "const": "preserve"
        },
        "layout_measurement": {
          "enum": [
            "none",
            "visual-lines"
          ]
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sizing",
        "overflow",
        "requires_final_width",
        "style_ownership"
      ],
      "properties": {
        "sizing": {
          "enum": [
            "content",
            "layout-slot"
          ]
        },
        "overflow": {
          "enum": [
            "visible",
            "hidden"
          ]
        },
        "requires_final_width": {
          "type": "boolean"
        },
        "style_ownership": {
          "const": "project"
        }
      }
    },
    "phaseTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_ms",
        "stagger_ms",
        "easing"
      ],
      "properties": {
        "duration_ms": {
          "type": "integer",
          "minimum": 1
        },
        "stagger_ms": {
          "type": "integer",
          "minimum": 0
        },
        "easing": {
          "enum": [
            "linear",
            "ease-in",
            "ease-out",
            "ease-in-out",
            "back-out",
            "spring-out",
            "step-end"
          ]
        }
      }
    },
    "replaceTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "overlap_ms",
        "micro_delay_ms"
      ],
      "properties": {
        "mode": {
          "enum": [
            "crossfade",
            "sequential"
          ]
        },
        "overlap_ms": {
          "type": "integer",
          "minimum": 0
        },
        "micro_delay_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enter",
        "exit",
        "replace",
        "hold_ms"
      ],
      "properties": {
        "enter": {
          "$ref": "#/$defs/phaseTiming"
        },
        "exit": {
          "$ref": "#/$defs/phaseTiming"
        },
        "replace": {
          "$ref": "#/$defs/replaceTiming"
        },
        "emphasis": {
          "$ref": "#/$defs/phaseTiming"
        },
        "hold_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "frameValues": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "x_px": {
          "type": "number"
        },
        "y_px": {
          "type": "number"
        },
        "scale": {
          "type": "number",
          "minimum": 0
        },
        "rotate_deg": {
          "type": "number"
        },
        "skew_x_deg": {
          "type": "number"
        },
        "blur_px": {
          "type": "number",
          "minimum": 0
        },
        "brightness": {
          "type": "number",
          "minimum": 0
        },
        "clip_top_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "letter_spacing_em": {
          "type": "number"
        },
        "shimmer_pct": {
          "type": "number"
        }
      }
    },
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offset",
        "values"
      ],
      "properties": {
        "offset": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "values": {
          "$ref": "#/$defs/frameValues"
        }
      }
    },
    "track": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/keyframe"
      }
    },
    "tracks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enter",
        "exit"
      ],
      "properties": {
        "enter": {
          "$ref": "#/$defs/track"
        },
        "exit": {
          "$ref": "#/$defs/track"
        },
        "emphasis": {
          "$ref": "#/$defs/track"
        }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "transform_origin",
        "unit_variation",
        "tracks"
      ],
      "properties": {
        "kind": {
          "enum": [
            "keyframes",
            "shimmer"
          ]
        },
        "transform_origin": {
          "enum": [
            "center",
            "top",
            "bottom",
            "left",
            "right"
          ]
        },
        "unit_variation": {
          "enum": [
            "none",
            "alternating",
            "depth"
          ]
        },
        "tracks": {
          "$ref": "#/$defs/tracks"
        }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "duration_ms"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "fade",
            "none"
          ]
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommended_max_graphemes",
        "recommended_max_lines",
        "layout_sensitive",
        "motion_intensity",
        "reduced_motion",
        "notes"
      ],
      "properties": {
        "recommended_max_graphemes": {
          "type": "integer",
          "minimum": 1
        },
        "recommended_max_lines": {
          "type": "integer",
          "minimum": 1
        },
        "layout_sensitive": {
          "type": "boolean"
        },
        "motion_intensity": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "reduced_motion": {
          "$ref": "#/$defs/reducedMotion"
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "reviewState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "id",
        "at",
        "meaning"
      ],
      "properties": {
        "operation": {
          "enum": [
            "enter",
            "exit",
            "replace",
            "emphasis"
          ]
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "at": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "meaning": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_states"
      ],
      "properties": {
        "key_states": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/reviewState"
          }
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "version",
        "id",
        "name",
        "aliases",
        "status",
        "source_ids",
        "host",
        "intent",
        "segmentation",
        "timing",
        "renderer",
        "constraints",
        "review"
      ],
      "properties": {
        "protocol": {
          "const": "visual-multimedia-text-motion"
        },
        "version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "status": {
          "enum": [
            "active",
            "experimental"
          ]
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "host": {
          "$ref": "#/$defs/host"
        },
        "intent": {
          "$ref": "#/$defs/intent"
        },
        "segmentation": {
          "$ref": "#/$defs/segmentation"
        },
        "timing": {
          "$ref": "#/$defs/timing"
        },
        "renderer": {
          "$ref": "#/$defs/renderer"
        },
        "constraints": {
          "$ref": "#/$defs/constraints"
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    },
    "catalogItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "aliases",
        "path",
        "sha256",
        "behavior_fingerprint",
        "operations",
        "default_operation",
        "unit",
        "energy",
        "host_sizing",
        "requires_final_width",
        "motion_intensity",
        "recommended_max_graphemes",
        "recommended_max_lines",
        "semantic_tags",
        "purpose",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "path": {
          "$ref": "#/$defs/relativeJsonPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "behavior_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "enter",
              "exit",
              "replace",
              "emphasis"
            ]
          }
        },
        "default_operation": {
          "enum": [
            "enter",
            "exit",
            "replace",
            "emphasis"
          ]
        },
        "unit": {
          "enum": [
            "whole",
            "grapheme",
            "word",
            "line"
          ]
        },
        "energy": {
          "enum": [
            "calm",
            "moderate",
            "expressive"
          ]
        },
        "host_sizing": {
          "enum": [
            "content",
            "layout-slot"
          ]
        },
        "requires_final_width": {
          "type": "boolean"
        },
        "motion_intensity": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "recommended_max_graphemes": {
          "type": "integer",
          "minimum": 1
        },
        "recommended_max_lines": {
          "type": "integer",
          "minimum": 1
        },
        "semantic_tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "purpose": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "enum": [
            "active",
            "experimental"
          ]
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "version",
        "library_version",
        "effect_count",
        "effects"
      ],
      "properties": {
        "protocol": {
          "const": "visual-multimedia-text-motion-catalog"
        },
        "version": {
          "const": 1
        },
        "library_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "effect_count": {
          "type": "integer",
          "minimum": 1
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/catalogItem"
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "version",
        "library_version",
        "effect_id",
        "operation",
        "effect_path",
        "runtime_path",
        "binding_path",
        "effect_sha256",
        "behavior_fingerprint",
        "time_source"
      ],
      "properties": {
        "protocol": {
          "const": "visual-multimedia-text-motion-selection"
        },
        "version": {
          "const": 1
        },
        "library_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "effect_id": {
          "$ref": "#/$defs/identifier"
        },
        "operation": {
          "enum": [
            "enter",
            "exit",
            "replace",
            "emphasis"
          ]
        },
        "effect_path": {
          "$ref": "#/$defs/relativeJsonPath"
        },
        "runtime_path": {
          "$ref": "#/$defs/relativeJsPath"
        },
        "binding_path": {
          "$ref": "#/$defs/relativeJsPath"
        },
        "effect_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "behavior_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "time_source": {
          "const": "editable-media"
        }
      }
    }
  }
}
