{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-multimedia.product-promo.v1",
  "title": "Visual Multimedia Product Promo v1 Documents",
  "oneOf": [
    {"$ref": "#/$defs/brief"},
    {"$ref": "#/$defs/plan"},
    {"$ref": "#/$defs/confirmation"}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "text": {"type": "string", "minLength": 1},
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "date": {"type": "string", "format": "date-time"},
    "localPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {"file": {"$ref": "#/$defs/localPath"}, "sha256": {"$ref": "#/$defs/sha"}}
    },
    "profileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": {"const": "product-promo"},
        "version": {"const": "1.0.0"},
        "sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "width", "height", "fps", "audio_sample_rate", "audio_channels", "caption_strategy"],
      "properties": {
        "file": {"$ref": "#/$defs/localPath"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "audio_sample_rate": {"type": "integer", "minimum": 8000},
        "audio_channels": {"type": "integer", "minimum": 1, "maximum": 8},
        "caption_strategy": {"enum": ["burned-in", "embedded-track", "sidecar", "none"]}
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "viewer_value", "proof", "required", "source_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"$ref": "#/$defs/text"},
        "viewer_value": {"$ref": "#/$defs/text"},
        "proof": {"$ref": "#/$defs/text"},
        "required": {"type": "boolean"},
        "source_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "project_id", "profile", "product", "features", "output", "sound", "constraints"],
      "properties": {
        "protocol": {"const": "visual-multimedia-product-promo-brief"},
        "version": {"const": 1},
        "project_id": {"$ref": "#/$defs/id"},
        "profile": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"const": "product-promo"}, "version": {"const": "1.0.0"}}},
        "product": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "audience", "value_proposition", "call_to_action"],
          "properties": {
            "name": {"$ref": "#/$defs/text"},
            "audience": {"$ref": "#/$defs/text"},
            "value_proposition": {"$ref": "#/$defs/text"},
            "call_to_action": {"type": "string"}
          }
        },
        "features": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/feature"}},
        "style_profile": {"oneOf": [{"$ref": "#/$defs/fileBinding"}, {"type": "null"}]},
        "output": {"$ref": "#/$defs/output"},
        "sound": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "strong_beat", "music_source_id"],
          "properties": {
            "strategy": {"enum": ["none", "sfx", "music-and-sfx"]},
            "strong_beat": {"type": "boolean"},
            "music_source_id": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._-]*$"}
          }
        },
        "constraints": {"type": "array", "items": {"$ref": "#/$defs/text"}}
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "purpose", "feature_ids", "selection", "implementation", "timeline_start_frame", "duration_frames", "semantic_steps"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "order": {"type": "integer", "minimum": 1},
        "purpose": {"$ref": "#/$defs/text"},
        "feature_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "selection": {"$ref": "#/$defs/fileBinding"},
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["package", "package_sha256", "manifest_sha256", "scene_id"],
          "properties": {
            "package": {"$ref": "#/$defs/localPath"},
            "package_sha256": {"$ref": "#/$defs/sha"},
            "manifest_sha256": {"$ref": "#/$defs/sha"},
            "scene_id": {"$ref": "#/$defs/id"}
          }
        },
        "timeline_start_frame": {"type": "integer", "minimum": 0},
        "duration_frames": {"type": "integer", "minimum": 1},
        "semantic_steps": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "shot_ids"],
      "properties": {
        "feature_id": {"$ref": "#/$defs/id"},
        "shot_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "promise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_pointer", "promise", "expected_value"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "source_pointer": {"type": "string", "pattern": "^(|/.*)$"},
        "promise": {"$ref": "#/$defs/text"},
        "expected_value": {}
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol", "version", "project_id", "created_at", "profile", "brief",
        "direction", "capture_reports", "sound", "feature_coverage", "shots",
        "review_promises", "output"
      ],
      "properties": {
        "protocol": {"const": "visual-multimedia-product-promo-plan"},
        "version": {"const": 1},
        "project_id": {"$ref": "#/$defs/id"},
        "created_at": {"$ref": "#/$defs/date"},
        "profile": {"$ref": "#/$defs/profileBinding"},
        "brief": {"$ref": "#/$defs/fileBinding"},
        "direction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "style_frames"],
          "properties": {
            "summary": {"$ref": "#/$defs/text"},
            "style_frames": {"type": "array", "items": {"$ref": "#/$defs/fileBinding"}}
          }
        },
        "capture_reports": {"type": "array", "items": {"$ref": "#/$defs/fileBinding"}},
        "sound": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile", "beat_analysis", "music_source_id"],
          "properties": {
            "profile": {"oneOf": [{"$ref": "#/$defs/fileBinding"}, {"type": "null"}]},
            "beat_analysis": {"oneOf": [{"$ref": "#/$defs/fileBinding"}, {"type": "null"}]},
            "music_source_id": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._-]*$"}
          }
        },
        "feature_coverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/coverage"}},
        "shots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/shot"}},
        "review_promises": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/promise"}},
        "output": {"$ref": "#/$defs/output"}
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "project_id", "plan", "plan_sha256", "confirmed_by", "confirmed_at", "evidence"],
      "properties": {
        "protocol": {"const": "visual-multimedia-product-promo-plan-confirmation"},
        "version": {"const": 1},
        "project_id": {"$ref": "#/$defs/id"},
        "plan": {"$ref": "#/$defs/localPath"},
        "plan_sha256": {"$ref": "#/$defs/sha"},
        "confirmed_by": {"enum": ["user", "agent"]},
        "confirmed_at": {"$ref": "#/$defs/date"},
        "evidence": {"$ref": "#/$defs/text"}
      }
    }
  }
}
