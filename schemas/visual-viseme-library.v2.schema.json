{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-multimedia.visual-viseme-library.v2",
  "title": "Visual Multimedia AI-reviewed Visual Viseme Library v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "version",
    "source_id",
    "source_fps",
    "source_frame_count",
    "source_crop_xywh",
    "annotation",
    "intensity_definition",
    "visual_identity",
    "runtime_state_spans",
    "closed_motion_clips",
    "gesture_clips",
    "natural_transition_spans"
  ],
  "properties": {
    "protocol": {
      "const": "visual-multimedia-visual-viseme-library"
    },
    "version": {
      "const": 2
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "source_fps": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "source_frame_count": {
      "type": "integer",
      "minimum": 1
    },
    "source_crop_xywh": {
      "$ref": "#/$defs/xywh"
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "reviewed_at",
        "reviewed_contact_sheets",
        "closed_motion_exhaustive_review",
        "notes"
      ],
      "properties": {
        "method": {
          "const": "ai-visual-review"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "reviewed_contact_sheets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "closed_motion_exhaustive_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exhaustive",
            "reviewed_frame_range",
            "decision"
          ],
          "properties": {
            "exhaustive": {
              "const": true
            },
            "reviewed_frame_range": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 1
                }
              ],
              "items": false
            },
            "decision": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "intensity_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "0",
        "1",
        "2",
        "3",
        "4",
        "important"
      ],
      "properties": {
        "0": {
          "type": "string",
          "minLength": 1
        },
        "1": {
          "type": "string",
          "minLength": 1
        },
        "2": {
          "type": "string",
          "minLength": 1
        },
        "3": {
          "type": "string",
          "minLength": 1
        },
        "4": {
          "type": "string",
          "minLength": 1
        },
        "important": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "visual_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "A",
        "I",
        "U",
        "E",
        "O",
        "CLOSED"
      ],
      "properties": {
        "A": {
          "type": "string",
          "minLength": 1
        },
        "I": {
          "type": "string",
          "minLength": 1
        },
        "U": {
          "type": "string",
          "minLength": 1
        },
        "E": {
          "type": "string",
          "minLength": 1
        },
        "O": {
          "type": "string",
          "minLength": 1
        },
        "CLOSED": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtime_state_spans": {
      "type": "array",
      "minItems": 11,
      "items": {
        "$ref": "#/$defs/runtimeSpan"
      }
    },
    "closed_motion_clips": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/closedClip"
      }
    },
    "gesture_clips": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/gestureClip"
      }
    },
    "natural_transition_spans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transitionSpan"
      }
    }
  },
  "$defs": {
    "xywh": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ],
      "items": false
    },
    "spanBase": {
      "type": "object",
      "required": [
        "start_frame",
        "end_frame_exclusive"
      ],
      "properties": {
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "end_frame_exclusive": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "runtimeSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viseme",
        "take",
        "start_frame",
        "end_frame_exclusive"
      ],
      "properties": {
        "viseme": {
          "enum": [
            "CLOSED",
            "A",
            "I",
            "U",
            "E",
            "O"
          ]
        },
        "take": {
          "type": "integer",
          "minimum": 1
        },
        "clip_id": {
          "type": "string",
          "minLength": 1
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "end_frame_exclusive": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "closedClip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start_frame",
        "end_frame_exclusive",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "end_frame_exclusive": {
          "type": "integer",
          "minimum": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "fiveFrames": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ],
      "items": false
    },
    "gestureClip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "viseme",
        "take",
        "start_frame",
        "end_frame_exclusive",
        "peak_strength_level",
        "rise_frames_by_intensity",
        "peak_frame_range_inclusive",
        "fall_frames_by_intensity",
        "representative_frames_by_intensity",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "viseme": {
          "enum": [
            "A",
            "I",
            "U",
            "E",
            "O"
          ]
        },
        "take": {
          "type": "integer",
          "minimum": 1
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "end_frame_exclusive": {
          "type": "integer",
          "minimum": 1
        },
        "peak_strength_level": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 4.0,
          "description": "AI 视觉审核得到的整条低→峰→低动作的绝对峰值张口强度；不同 take 不保证强度不同。"
        },
        "rise_frames_by_intensity": {
          "$ref": "#/$defs/fiveFrames",
          "description": "动作内部相对阶段 0..4 的上升帧；所有帧都必须位于 [start_frame, end_frame_exclusive)。"
        },
        "peak_frame_range_inclusive": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ],
          "items": false
        },
        "fall_frames_by_intensity": {
          "$ref": "#/$defs/fiveFrames",
          "description": "动作内部相对阶段 0..4 的下降帧；索引 0 必须严格等于 end_frame_exclusive - 1。"
        },
        "representative_frames_by_intensity": {
          "$ref": "#/$defs/fiveFrames",
          "description": "动作内部相对阶段 0..4 的代表帧；不是绝对张口强度。"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "transitionSpan": {
      "type": "object",
      "additionalProperties": false,
      "not": {
        "anyOf": [
          {
            "required": ["from", "to"],
            "properties": {
              "from": { "const": "A" },
              "to": { "const": "A" }
            }
          },
          {
            "required": ["from", "to"],
            "properties": {
              "from": { "const": "I" },
              "to": { "const": "I" }
            }
          },
          {
            "required": ["from", "to"],
            "properties": {
              "from": { "const": "U" },
              "to": { "const": "U" }
            }
          },
          {
            "required": ["from", "to"],
            "properties": {
              "from": { "const": "E" },
              "to": { "const": "E" }
            }
          },
          {
            "required": ["from", "to"],
            "properties": {
              "from": { "const": "O" },
              "to": { "const": "O" }
            }
          }
        ]
      },
      "required": [
        "from",
        "to",
        "start_frame",
        "end_frame_exclusive",
        "take"
      ],
      "properties": {
        "from": {
          "enum": [
            "A",
            "I",
            "U",
            "E",
            "O"
          ]
        },
        "to": {
          "enum": [
            "A",
            "I",
            "U",
            "E",
            "O"
          ]
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "end_frame_exclusive": {
          "type": "integer",
          "minimum": 1
        },
        "take": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
